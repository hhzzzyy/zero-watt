# Template for a per-user unit. The application copies this file to
# ~/.config/systemd/user/zero-watt-collector.service and starts it with
# `systemctl --user`. It runs as the logged-in user, so User= is not used.
[Unit]
Description=Zero Watt battery collector

[Service]
Type=simple
ExecStart=/usr/bin/zero-watt --collect
Restart=on-failure
RestartSec=2
UMask=0077
